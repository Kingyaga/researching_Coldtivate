def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

platform :ios, min_ios_version_supported
prepare_react_native_project!

setup_permissions([
  'LocationAccuracy',
  'LocationAlways',
  'LocationWhenInUse',
  'PhotoLibrary',
])

target 'coldtivate' do
  config = use_native_modules!

  # Custom filesystem module
  pod 'CldtFS', :path => 'CldtFS.podspec'

  # Mapbox: make transitive headers modular to avoid Xcode 16/Fabric issues
  pod 'MapboxCommon', :modular_headers => true
  pod 'MapboxMaps',   :modular_headers => true
  pod 'NitroModules', :path => '../node_modules/react-native-nitro-modules'

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pre_install do |installer|
    $RNMapboxMaps.pre_install(installer)
  end

  target 'coldtivateTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # React Native’s standard post-install
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
      # :ccache_enabled => true
    )

    # Mapbox’s post-install
    $RNMapboxMaps.post_install(installer)

    # --- BEGIN: header/module guardrails for noisy pods ---
    %w[
      rnmapbox-maps
      react-native-safe-area-context
      React-Fabric
      React-RCTFabric
      react-native-mmkv
    ].each do |name|
      t = installer.pods_project.targets.find { |x| x.name == name }
      next unless t
      t.build_configurations.each do |c|
        c.build_settings['CLANG_ENABLE_MODULES'] = 'NO'
        c.build_settings['DEFINES_MODULE'] = 'NO'
        c.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'NO'
        c.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        c.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      end
    end

    # MMKV: avoid simulator crypto asm that sometimes trips compilers
    if (t = installer.pods_project.targets.find { |x| x.name == 'react-native-mmkv' })
      t.build_configurations.each do |c|
        c.build_settings['GCC_PREPROCESSOR_DEFINITIONS[sdk=iphonesimulator*]'] = 'MMKV_DISABLE_CRYPT=1'
        c.build_settings['EXCLUDED_SOURCE_FILE_NAMES[sdk=iphonesimulator*]'] =
          'ThreadLock_Win32.cpp openssl_aes-armv4.S'
      end
    end
    # --- END: guardrails ---

    # (Optional) You can delete any legacy bitcode_strip calls here; bitcode is deprecated.
  end
end
