# ========================
# Windows
# ========================
Thumbs.db         # Windows thumbnail cache
ehthumbs.db       # Windows media preview cache
Desktop.ini       # Windows folder settings
$RECYCLE.BIN/     # Windows recycle bin metadata
*.lnk             # Windows shortcuts

# ========================
# Linux
# ========================
*~                # Backup files
.nfs*             # NFS temporary files

