{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#/*": ["src/*"],
      "#assets/*": ["src/assets/*"],
      "#components/*": ["src/components/*"],
      "#i18n/*": ["src/i18n/*"],
      "#layouts/*": ["src/layouts/*"]
    },
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
