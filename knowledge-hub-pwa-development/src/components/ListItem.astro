---
interface Props {
  label: string;
  link: string;
  isRtl: boolean
}

const { label, link, isRtl } = Astro.props;

---
<a href={link} class="flex items-center justify-between p-4 hover:bg-gray-50 active:bg-gray-100 transition-colors border-b border-gray-200">
  <div class="hint">
    <p class="text-gray-900 text-base">{label}</p>
  </div>
  <svg xmlns="http://www.w3.org/2000/svg" class={`h-5 w-5 text-gray-600 ${isRtl ? 'rotate-180' : ''}`} viewBox="0 0 20 20" fill="currentColor">
    <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
  </svg>
</a>
